{
  "title": "Fraud Detection — Operations Dashboard",
  "uid": "fraud-ops-v2",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "title": "Decision Throughput (TPS)", "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "sum(rate(gateway_txn_total[1m]))", "legendFormat": "TPS" }],
      "options": { "colorMode": "background", "thresholds": { "steps": [
        {"color":"green","value":null}, {"color":"yellow","value":500}, {"color":"red","value":900}
      ]}}
    },
    {
      "id": 2, "title": "Block Rate %", "type": "gauge",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "100*sum(rate(stage3_decisions_total{action='BLOCK'}[5m]))/sum(rate(stage3_decisions_total[5m]))", "legendFormat": "Block %" }],
      "options": { "thresholds": { "steps": [
        {"color":"green","value":null}, {"color":"yellow","value":8}, {"color":"red","value":15}
      ]}}
    },
    {
      "id": 3, "title": "p95 Latency (ms)", "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(gateway_e2e_latency_ms_bucket[5m])) by (le))", "legendFormat": "p95" }],
      "options": { "colorMode": "background", "thresholds": { "steps": [
        {"color":"green","value":null}, {"color":"yellow","value":150}, {"color":"red","value":200}
      ]}}
    },
    {
      "id": 4, "title": "Early Exit Rate %", "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "100*sum(rate(gateway_early_exit_total[5m]))/sum(rate(gateway_txn_total[5m]))", "legendFormat": "Early Exit %" }],
      "options": { "colorMode": "background", "thresholds": { "steps": [
        {"color":"blue","value":null}, {"color":"green","value":50}
      ]}}
    },
    {
      "id": 5, "title": "Labels Received (feedback-service)", "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "sum(rate(feedback_labels_received_total[5m]))*60", "legendFormat": "Labels/min" }],
      "options": { "colorMode": "background" }
    },
    {
      "id": 6, "title": "Rolling FNR by Model Version", "type": "gauge",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "max(feedback_model_fnr) by (model_version)", "legendFormat": "{{ model_version }}" }],
      "options": { "thresholds": { "steps": [
        {"color":"green","value":null}, {"color":"yellow","value":0.10}, {"color":"red","value":0.15}
      ]}}
    },
    {
      "id": 7, "title": "End-to-End Latency Percentiles (ms)", "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 6 },
      "targets": [
        {"expr":"histogram_quantile(0.50,sum(rate(gateway_e2e_latency_ms_bucket[1m]))by(le))","legendFormat":"p50"},
        {"expr":"histogram_quantile(0.95,sum(rate(gateway_e2e_latency_ms_bucket[1m]))by(le))","legendFormat":"p95"},
        {"expr":"histogram_quantile(0.99,sum(rate(gateway_e2e_latency_ms_bucket[1m]))by(le))","legendFormat":"p99"}
      ]
    },
    {
      "id": 8, "title": "Action Distribution (5m rate)", "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 6 },
      "targets": [
        {"expr":"sum(rate(stage3_decisions_total{action='APPROVE'}[5m]))","legendFormat":"APPROVE"},
        {"expr":"sum(rate(stage3_decisions_total{action='BLOCK'}[5m]))","legendFormat":"BLOCK"},
        {"expr":"sum(rate(stage3_decisions_total{action='STEP_UP_AUTH'}[5m]))","legendFormat":"STEP_UP"},
        {"expr":"sum(rate(stage3_decisions_total{action='MANUAL_REVIEW'}[5m]))","legendFormat":"REVIEW"}
      ]
    },
    {
      "id": 9, "title": "Feedback Loop — Labels by Source", "type": "timeseries",
      "gridPos": { "x": 0, "y": 10, "w": 8, "h": 5 },
      "targets": [
        {"expr":"sum(rate(feedback_labels_received_total[5m]))by(source)","legendFormat":"{{ source }}"}
      ]
    },
    {
      "id": 10, "title": "MLOps — Labels Since Last Retrain", "type": "timeseries",
      "gridPos": { "x": 8, "y": 10, "w": 8, "h": 5 },
      "targets": [
        {"expr":"mlops_labels_accumulated","legendFormat":"{{ model_version }}"}
      ]
    },
    {
      "id": 11, "title": "Circuit Breaker States (Stage 2)", "type": "stat",
      "gridPos": { "x": 16, "y": 10, "w": 8, "h": 5 },
      "targets": [
        {"expr":"stage2_circuit_state","legendFormat":"{{ component }}"}
      ],
      "options": { "colorMode": "background", "thresholds": { "steps": [
        {"color":"green","value":null}, {"color":"yellow","value":1}, {"color":"orange","value":2}
      ]}}
    },
    {
      "id": 12, "title": "Transaction Adapter Throughput", "type": "timeseries",
      "gridPos": { "x": 0, "y": 15, "w": 8, "h": 5 },
      "targets": [
        {"expr":"sum(rate(adapter_published_total[1m]))by(adapter)","legendFormat":"{{ adapter }}"},
        {"expr":"sum(rate(adapter_errors_total[1m]))by(adapter)","legendFormat":"errors ({{ adapter }})"}
      ]
    },
    {
      "id": 13, "title": "Model Drift — Max PSI over Time", "type": "timeseries",
      "gridPos": { "x": 8, "y": 15, "w": 8, "h": 5 },
      "targets": [
        {"expr":"fraud_feature_psi_max","legendFormat":"Max PSI"},
        {"expr":"0.25","legendFormat":"Drift threshold"}
      ]
    },
    {
      "id": 14, "title": "MLflow Model AUC — Production Versions", "type": "stat",
      "gridPos": { "x": 16, "y": 15, "w": 8, "h": 5 },
      "targets": [
        {"expr":"mlflow_model_val_auc{stage='Production'}","legendFormat":"{{ model_name }}"}
      ],
      "options": { "colorMode": "background", "thresholds": { "steps": [
        {"color":"red","value":null}, {"color":"yellow","value":0.90}, {"color":"green","value":0.93}
      ]}}
    },
    {
      "id": 15, "title": "Service Health (1=up, 0=down)", "type": "stat",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 3 },
      "targets": [
        {"expr":"up{job='api-gateway'}","legendFormat":"Gateway"},
        {"expr":"up{job='stage1-fast-risk'}","legendFormat":"Stage1"},
        {"expr":"up{job='stage2-deep-intel'}","legendFormat":"Stage2"},
        {"expr":"up{job='stage3-decision-engine'}","legendFormat":"Stage3"},
        {"expr":"up{job='feedback-service'}","legendFormat":"Feedback"},
        {"expr":"up{job='mlops-service'}","legendFormat":"MLOps"},
        {"expr":"up{job='webhook-adapter'}","legendFormat":"Webhook"},
        {"expr":"up{job='redpanda'}","legendFormat":"Redpanda"},
        {"expr":"up{job='redis'}","legendFormat":"Redis"},
        {"expr":"up{job='postgres'}","legendFormat":"PostgreSQL"},
        {"expr":"up{job='neo4j'}","legendFormat":"Neo4j"},
        {"expr":"up{job='clickhouse'}","legendFormat":"ClickHouse"},
        {"expr":"up{job='app-backend'}","legendFormat":"AppBackend"}
      ],
      "options": { "colorMode": "background", "thresholds": {"steps":[{"color":"red","value":null},{"color":"green","value":1}]}}
    }
  ]
}
