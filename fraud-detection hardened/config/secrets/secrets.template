# Required secrets — replace every CHANGE_ME before deploying.
# Generate strong values: python3 -c "import secrets; print(secrets.token_hex(32))"

POSTGRES_PASSWORD=CHANGE_ME_MIN_20_CHARS
CLICKHOUSE_PASSWORD=CHANGE_ME_MIN_20_CHARS
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_MIN_16_CHARS
NEO4J_PASSWORD=CHANGE_ME_MIN_12_CHARS

# JWT — minimum 48 chars, cryptographically random
JWT_SECRET=CHANGE_ME_GENERATE_WITH_SECRETS_MODULE_MIN_48_CHARS
# Anonymisation salt — changing this invalidates all existing pseudonyms
ANON_SALT=CHANGE_ME_GENERATE_WITH_SECRETS_MODULE_MIN_32_CHARS
# Webhook HMAC signing secret
WEBHOOK_SECRET=CHANGE_ME_MIN_32_CHARS
# Adapter API keys (comma-separated), format: fdk_{random}
ADAPTER_API_KEYS=CHANGE_ME

# Airflow
AIRFLOW_SECRET_KEY=CHANGE_ME_MIN_32_CHARS
AIRFLOW_FERNET_KEY=CHANGE_ME_BASE64_FERNET_KEY
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_MIN_16_CHARS

# Vault (dev mode only — use external cluster in production)
VAULT_TOKEN=CHANGE_ME_DEV_ONLY

# CORS — no wildcards in production
CORS_ORIGINS=CHANGE_ME_NO_WILDCARDS
ENVIRONMENT=development
